<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Application History - Internship Portal</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</head>
<body>
    <%- include('partials/navbar') %>

    <div class="container mt-4">
        <h2>Application Status History</h2>
        <p><strong>Student:</strong> <%= application.username %></p>
        <p><strong>Internship:</strong> <%= application.companyName %> - <%= application.jobTitle %></p>

        <table class="table table-hover">
            <thead><tr><th>Status</th><th>Changed Date</th></tr></thead>
            <tbody>
                <% for (let i = 0; i < history.length; i++) { %>
                    <tr><td><%= history[i].status %></td><td><%= history[i].changedDate %></td></tr>
                <% } %>
                <% if (history.length === 0) { %>
                    <tr><td colspan="2">No status history found.</td></tr>
                <% } %>
            </tbody>
        </table>

        <% if (user.role === 'admin') { %>
            <a href="/applications" class="btn btn-secondary">Back</a>
        <% } else { %>
            <a href="/myApplications" class="btn btn-secondary">Back</a>
        <% } %>
    </div>
</body>
</html>
