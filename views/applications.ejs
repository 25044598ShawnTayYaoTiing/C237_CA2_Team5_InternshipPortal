<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Student Applications - RP Internship Portal</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</head>
<body style="background-color: #FFF8E7;">
    <%- include('partials/navbar') %>

    <div class="container mt-5">
        <h1>Student Applications</h1>
        <p>Review RP student applications and update their status.</p>

        <% if (message) { %>
            <div class="alert alert-success"><%= message %></div>
        <% } %>

        <form action="/applications" method="GET" class="card p-3 mb-4">
            <div class="row g-3">
                <div class="col-md-4">
                    <label for="status" class="form-label">Filter by Status:</label>
                    <select id="status" name="status" class="form-select">
                        <option value="">All Statuses</option>
                        <option value="Pending" <%= selectedStatus === 'Pending' ? 'selected' : '' %>>Pending</option>
                        <option value="Shortlisted" <%= selectedStatus === 'Shortlisted' ? 'selected' : '' %>>Shortlisted</option>
                        <option value="Interview" <%= selectedStatus === 'Interview' ? 'selected' : '' %>>Interview</option>
                        <option value="Offered" <%= selectedStatus === 'Offered' ? 'selected' : '' %>>Offered</option>
                        <option value="Accepted" <%= selectedStatus === 'Accepted' ? 'selected' : '' %>>Accepted</option>
                        <option value="Rejected" <%= selectedStatus === 'Rejected' ? 'selected' : '' %>>Rejected</option>
                    </select>
                </div>
                <div class="col-md-8 align-self-end">
                    <button type="submit" class="btn btn-primary">Filter</button>
                    <a href="/applications" class="btn btn-secondary">Clear</a>
                </div>
            </div>
        </form>

        <div class="table-responsive">
            <table class="table table-striped table-bordered align-middle">
                <thead>
                    <tr>
                        <th>Student</th>
                        <th>Internship</th>
                        <th>Resume</th>
                        <th>Cover Letter</th>
                        <th>Current Status</th>
                        <th>Status Update</th>
                    </tr>
                </thead>
                <tbody>
                    <% for (let i = 0; i < applications.length; i++) { %>
                        <tr>
                            <td>
                                <strong><%= applications[i].username %></strong><br>
                                <small class="text-muted"><%= applications[i].email %></small>
                            </td>
                            <td>
                                <strong><%= applications[i].jobTitle %></strong><br>
                                <%= applications[i].companyName %><br>
                                <small class="text-muted">Applied: <%= applications[i].appliedDate %></small>
                            </td>
                            <!-- ==========================================
                            Done by: SHAWN TAY YAO TING (25044598)
                            Feature: Submitted Resume Access
                            ========================================== -->
                            <td>
                                <% if (applications[i].resumeId) { %>
                                    <a href="/document/<%= applications[i].resumeId %>" target="_blank" class="btn btn-dark btn-sm">
                                        <%= applications[i].resumeFileName %>
                                    </a>
                                <% } else { %>
                                    No Resume
                                <% } %>
                            </td>
                            <td class="text-break"><small><%= applications[i].coverLetter || 'No Cover Letter' %></small></td>
                            <td>
                                <% let statusClass = 'bg-secondary'; %>
                                <% if (applications[i].status === 'Pending') { statusClass = 'bg-warning text-dark'; } %>
                                <% if (applications[i].status === 'Shortlisted') { statusClass = 'bg-info text-dark'; } %>
                                <% if (applications[i].status === 'Interview') { statusClass = 'bg-primary'; } %>
                                <% if (applications[i].status === 'Offered') { statusClass = 'bg-primary'; } %>
                                <% if (applications[i].status === 'Accepted') { statusClass = 'bg-success'; } %>
                                <% if (applications[i].status === 'Rejected') { statusClass = 'bg-danger'; } %>
                                <span class="badge <%= statusClass %>"><%= applications[i].status %></span><br>
                                <a href="/application/<%= applications[i].applicationId %>/history">History</a>
                            </td>
                            <td>
                                <form action="/updateApplication/<%= applications[i].applicationId %>" method="POST">
                                    <select name="status" class="form-select form-select-sm mb-2" required>
                                        <option value="Pending" <%= applications[i].status === 'Pending' ? 'selected' : '' %>>Pending</option>
                                        <option value="Shortlisted" <%= applications[i].status === 'Shortlisted' ? 'selected' : '' %>>Shortlisted</option>
                                        <option value="Interview" <%= applications[i].status === 'Interview' ? 'selected' : '' %>>Interview</option>
                                        <option value="Offered" <%= applications[i].status === 'Offered' ? 'selected' : '' %>>Offered</option>
                                        <option value="Accepted" <%= applications[i].status === 'Accepted' ? 'selected' : '' %>>Accepted</option>
                                        <option value="Rejected" <%= applications[i].status === 'Rejected' ? 'selected' : '' %>>Rejected</option>
                                    </select>
                                    <small>Interview Details:</small>
                                    <input type="date" name="interviewDate" class="form-control form-control-sm mb-1"
                                        value="<%= applications[i].interviewDate || '' %>">
                                    <input type="time" name="interviewTime" class="form-control form-control-sm mb-1"
                                        value="<%= applications[i].interviewTime || '' %>">
                                    <input type="text" name="interviewLocation" class="form-control form-control-sm mb-1"
                                        placeholder="Interview location"
                                        value="<%= applications[i].interviewLocation || '' %>">
                                    <input type="url" name="meetingLink" class="form-control form-control-sm mb-1"
                                        placeholder="https://meeting-link"
                                        value="<%= applications[i].meetingLink || '' %>">
                                    <textarea name="interviewNotes" class="form-control form-control-sm mb-2"
                                        placeholder="Interview notes"><%= applications[i].interviewNotes || '' %></textarea>
                                    <button type="submit" class="btn btn-primary btn-sm">Update</button>
                                </form>
                            </td>
                        </tr>
                    <% } %>

                    <% if (applications.length === 0) { %>
                        <tr>
                            <td colspan="6" class="text-center">No applications found.</td>
                        </tr>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>
</body>
</html>
