<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Apply for Internship - RP Internship Portal</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</head>
<body style="background-color: #FFF8E7;">
    <%- include('partials/navbar') %>

    <div class="container mt-5">
        <h1>Apply for Internship</h1>
        <p>Choose a resume and submit your application.</p>

        <div class="card p-3 mb-4">
            <h4>Internship</h4>
            <p><strong>Company:</strong> <%= internship.companyName %></p>
            <p><strong>Job Title:</strong> <%= internship.jobTitle %></p>
            <p><strong>Closing Date:</strong> <%= internship.closingDate || 'Not specified' %></p>
        </div>

        <% if (error) { %>
            <div class="alert alert-danger"><%= error %></div>
        <% } %>

        <form action="/apply/<%= internship.internshipId %>" method="POST" class="card p-3">
            <div class="mb-3">
                <label for="resumeId" class="form-label">Selected Resume:</label>
                <select id="resumeId" name="resumeId" class="form-select" required>
                    <option value="">Select a resume</option>
                    <% for (let i = 0; i < documents.length; i++) { %>
                        <option value="<%= documents[i].documentId %>">
                            <%= documents[i].resumeName || documents[i].fileName %> (<%= documents[i].documentType %>)
                        </option>
                    <% } %>
                </select>
                <% if (documents.length === 0) { %>
                    <p class="mt-2">Upload a resume from your <a href="/profile">Profile</a> before applying.</p>
                <% } %>
            </div>
            <div class="mb-3">
                <label for="coverLetter" class="form-label">Cover Letter (Optional):</label>
                <textarea id="coverLetter" name="coverLetter" class="form-control" rows="6"
                    maxlength="1000"></textarea>
                <small class="form-text text-muted">Maximum 1000 characters.</small>
            </div>
            <button type="submit" class="btn btn-primary" <%= documents.length === 0 ? 'disabled' : '' %>>Submit Application</button>
            <a href="/internship/<%= internship.internshipId %>" class="btn btn-secondary">Cancel</a>
        </form>
    </div>
</body>
</html>
