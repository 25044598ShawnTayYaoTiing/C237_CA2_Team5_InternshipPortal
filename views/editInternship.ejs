<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Internship - RP Internship Portal</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</head>
<body style="background-color: #FFF8E7;">
    <%- include('partials/navbar') %>

    <div class="container mt-5">
        <h1>Edit Internship</h1>
        <p>Update the internship listing shown to RP students.</p>

        <% if (error) { %>
            <div class="alert alert-danger"><%= error %></div>
        <% } %>

        <form action="/editInternship/<%= internship.internshipId %>" method="POST" class="card p-3">
            <div class="mb-3">
                <label for="companyName" class="form-label">Company Name:</label>
                <input type="text" id="companyName" name="companyName" class="form-control"
                    value="<%= internship.companyName %>" required>
            </div>

            <div class="mb-3">
                <label for="jobTitle" class="form-label">Job Title:</label>
                <input type="text" id="jobTitle" name="jobTitle" class="form-control"
                    value="<%= internship.jobTitle %>" required>
            </div>

            <div class="mb-3">
                <label for="school" class="form-label">School:</label>
                <select id="school" name="school" class="form-select" required>
                    <option value="">Select School</option>
                    <% for (const schoolName in schoolDiplomas) { %>
                        <option value="<%= schoolName %>"
                            <%= internship.school === schoolName ? 'selected' : '' %>>
                            <%= schoolName %> - <%= schoolNames[schoolName] %>
                        </option>
                    <% } %>
                </select>
            </div>

            <div class="mb-3">
                <label for="diploma" class="form-label">Diploma:</label>
                <select id="diploma" name="diploma" class="form-select" required>
                    <option value="">Select Diploma</option>
                    <% for (const schoolName in schoolDiplomas) { %>
                        <% for (let i = 0; i < schoolDiplomas[schoolName].length; i++) { %>
                            <option value="<%= schoolDiplomas[schoolName][i] %>" data-school="<%= schoolName %>"
                                <%= internship.diploma === schoolDiplomas[schoolName][i] ? 'selected' : '' %>>
                                <%= schoolDiplomas[schoolName][i] %>
                            </option>
                        <% } %>
                    <% } %>
                </select>
            </div>

            <div class="mb-3">
                <label for="category" class="form-label">Category:</label>
                <select id="category" name="category" class="form-select" required>
                    <option value="">Select Category</option>
                    <% for (let i = 0; i < internshipCategories.length; i++) { %>
                        <option value="<%= internshipCategories[i] %>"
                            <%= internship.category === internshipCategories[i] ? 'selected' : '' %>>
                            <%= internshipCategories[i] %>
                        </option>
                    <% } %>
                </select>
            </div>

            <div class="mb-3">
                <label for="location" class="form-label">Location:</label>
                <input type="text" id="location" name="location" class="form-control"
                    value="<%= internship.location %>" required>
            </div>

            <div class="mb-3">
                <label for="allowance" class="form-label">Monthly Allowance ($):</label>
                <input type="number" id="allowance" name="allowance" class="form-control"
                    min="0" step="0.01" value="<%= internship.allowance %>" required>
            </div>

            <div class="mb-3">
                <label for="description" class="form-label">Description:</label>
                <textarea id="description" name="description" class="form-control" rows="4" required><%= internship.description %></textarea>
            </div>

            <div class="mb-3">
                <label for="requirements" class="form-label">Requirements:</label>
                <textarea id="requirements" name="requirements" class="form-control" rows="4" required><%= internship.requirements %></textarea>
            </div>

            <div class="mb-3">
                <label for="closingDate" class="form-label">Closing Date:</label>
                <input type="date" id="closingDate" name="closingDate" class="form-control"
                    value="<%= internship.closingDate %>" required>
            </div>

            <div>
                <button type="submit" class="btn btn-warning">Update Internship</button>
                <a href="/internships" class="btn btn-secondary">Cancel</a>
            </div>
        </form>
    </div>
    <script>
        const schoolSelect = document.getElementById('school');
        const diplomaSelect = document.getElementById('diploma');

        function updateDiplomas() {
            for (let i = 1; i < diplomaSelect.options.length; i++) {
                const option = diplomaSelect.options[i];
                const matches = option.dataset.school === schoolSelect.value;
                option.hidden = !matches;
                option.disabled = !matches;
            }
            if (diplomaSelect.selectedOptions[0] && diplomaSelect.selectedOptions[0].disabled) {
                diplomaSelect.value = '';
            }
        }

        schoolSelect.addEventListener('change', updateDiplomas);
        updateDiplomas();
    </script>
</body>
</html>
