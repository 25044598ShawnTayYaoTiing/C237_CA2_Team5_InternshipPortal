<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>RP Internship Portal</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</head>
<body style="background-color: #FFF8E7;">
    <%- include('partials/navbar') %>

    <div class="container mt-5 text-center d-flex flex-column align-items-center justify-content-center" style="min-height: 80vh;">
        <h1>RP Internship Portal</h1>
        <p>Browse internship opportunities relevant to your school and manage your internship applications.</p>

        <% if (user) { %>
            <p>Welcome, <%= user.username %>. You are logged in as <%= user.role %>.</p>

            <div class="row mt-4 g-3">
                <!-- =====================================================
                Done By: ZELIA TAN LING RUI 25046792
                Feature: Internship Opportunities Entry Point
                ===================================================== -->
                <div class="col-12 col-md-4">
                    <div class="card p-3 h-100 d-flex flex-column">
                        <h4>Internship Opportunities</h4>
                        <p>Search and view internships for RP students.</p>
                        <a href="/internships" class="btn btn-dark mt-auto w-100">View Opportunities</a>
                    </div>
                </div>

                <% if (user.role === 'student') { %>
                    <!-- =====================================================
                    Done By: WONG ZHI LI 25033271
                    Feature: Student Applications Entry Point
                    ===================================================== -->
                    <div class="col-12 col-md-4">
                        <div class="card p-3 h-100 d-flex flex-column">
                            <h4>My Applications</h4>
                            <p>Check your submitted applications & interviews.</p>
                            <a href="/myApplications" class="btn btn-primary mt-auto w-100">My Applications</a>
                        </div>
                    </div>

                    <!-- =====================================================
                    Done By: YAP CHIEN TING QUINA 25041331
                    Feature: Saved Internships Entry Point
                    ===================================================== -->
                    <div class="col-12 col-md-4">
                        <div class="card p-3 h-100 d-flex flex-column">
                            <h4>Saved Internships</h4>
                            <p>Review internships you saved for later.</p>
                            <a href="/savedInternships" class="btn btn-secondary mt-auto w-100">Saved Internships</a>
                        </div>
                    </div>
                <% } %>

                <% if (user.role === 'admin') { %>
                    <!-- =====================================================
                    Done By: ZELIA TAN LING RUI 25046792
                    Feature: Add Internship Entry Point
                    ===================================================== -->
                    <div class="col-12 col-md-4">
                        <div class="card p-3 h-100 d-flex flex-column">
                            <h4>Add Internship</h4>
                            <p>Create a new internship listing for RP students.</p>
                            <a href="/addInternship" class="btn btn-primary mt-auto w-100">Add Internship</a>
                        </div>
                    </div>

                    <!-- =====================================================
                    Done By: WONG ZHI LI 25033271
                    Feature: Admin Applications Entry Point
                    ===================================================== -->
                    <div class="col-12 col-md-4">
                        <div class="card p-3 h-100 d-flex flex-column">
                            <h4>Applications</h4>
                            <p>Review student applications and update statuses.</p>
                            <a href="/applications" class="btn btn-secondary mt-auto w-100">View Applications</a>
                        </div>
                    </div>
                <% } %>
            </div>
        <% } else { %>
            <div class="mt-4">
                <a href="/login" class="btn btn-primary">Login</a>
                <a href="/register" class="btn btn-secondary">Register as Student</a>
            </div>
        <% } %>
    </div>
</body>
</html>
