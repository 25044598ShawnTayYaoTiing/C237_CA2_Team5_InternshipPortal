<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Internship Details - RP Internship Portal</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</head>
<body>
    <%- include('partials/navbar') %>

    <div class="container mt-5">
        <h1>Internship Details</h1>
        <p>Review the internship information before applying or saving.</p>

        <% if (message) { %>
            <div class="alert alert-success"><%= message %></div>
        <% } %>

        <% if (error) { %>
            <div class="alert alert-danger"><%= error %></div>
        <% } %>

        <!-- ==========================================
        Done by: ZELIA TAN LING RUI (25046792)
        Feature: Individual Internship Details
        ========================================== -->
        <div class="card p-3 mb-4">
            <h4><%= internship.jobTitle %></h4>
            <p><strong>Company Name:</strong> <%= internship.companyName %></p>

            <table class="table table-bordered">
                <tbody>
                    <tr>
                        <th>Location</th>
                        <td><%= internship.location %></td>
                    </tr>
                    <tr>
                        <th>Allowance</th>
                        <td>$<%= Number(internship.allowance).toFixed(2) %></td>
                    </tr>
                    <tr>
                        <th>School</th>
                        <td><%= internship.school || '-' %></td>
                    </tr>
                    <tr>
                        <th>Diploma</th>
                        <td><%= internship.diploma || '-' %></td>
                    </tr>
                    <tr>
                        <th>Category</th>
                        <td><%= internship.category || '-' %></td>
                    </tr>
                    <tr>
                        <th>Closing Date</th>
                        <td>
                            <%= internship.closingDate %>
                            <!-- Done by: YAP CHIEN TING QUINA (25041331) - Closing Soon display -->
                            <% if (internship.closingSoon) { %>
                                <span class="badge bg-warning text-dark">Closing Soon</span>
                            <% } %>
                        </td>
                    </tr>
                </tbody>
            </table>

            <p><strong>Description:</strong><br><%= internship.description %></p>
            <p><strong>Requirements:</strong><br><%= internship.requirements %></p>
        </div>

        <!-- ==========================================
        Shared contribution:
        Done by: ZIN WITYEE AUNG (25040225) - student role visibility
        Done by: SHAWN TAY YAO TING (25044598) - application entry point and closing checks
        ========================================== -->
        <% if (user.role === 'student') { %>
            <% if (hasApplied) { %>
                <div class="alert alert-info">You have already applied for this internship.</div>
            <% } else if (!internship.isOpen) { %>
                <div class="alert alert-warning"><strong>Applications Closed</strong></div>
            <% } else { %>
                <a href="/apply/<%= internship.internshipId %>" class="btn btn-primary">Apply</a>
            <% } %>

            <!-- ==========================================
            Done by: YAP CHIEN TING QUINA (25041331)
            Feature: Save and Unsave Internship Controls
            ========================================== -->
            <% if (internship.isSaved) { %>
                <form action="/unsaveInternship/<%= internship.internshipId %>" method="POST" class="d-inline">
                    <button type="submit" class="btn btn-secondary">Unsave</button>
                </form>
            <% } else { %>
                <form action="/saveInternship/<%= internship.internshipId %>" method="POST" class="d-inline">
                    <button type="submit" class="btn btn-secondary">Save</button>
                </form>
            <% } %>
        <% } %>

        <!-- ==========================================
        Shared contribution:
        Done by: ZIN WITYEE AUNG (25040225) - admin role visibility
        Done by: ZELIA TAN LING RUI (25046792) - edit internship entry point
        ========================================== -->
        <% if (user.role === 'admin') { %>
            <a href="/editInternship/<%= internship.internshipId %>" class="btn btn-warning">Edit</a>
        <% } %>

        <a href="/internships" class="btn btn-secondary">Back</a>
    </div>
</body>
</html>
