<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Internship Details - Internship Portal</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</head>
<body>
    <%- include('partials/navbar') %>

    <div class="container mt-4">
        <h2>Internship Details</h2>

        <% if (message) { %>
            <div class="alert alert-success"><%= message %></div>
        <% } %>

        <% if (error) { %>
            <div class="alert alert-danger"><%= error %></div>
        <% } %>

        <!-- ==========================================
        Done by: ZELIA TAN LING RUI (25046792)
        Feature: Individual Internship Details
        ========================================== -->
        <p><strong>Company:</strong><br><%= internship.companyName %></p>
        <p><strong>Job Title:</strong><br><%= internship.jobTitle %></p>
        <p><strong>School:</strong><br><%= internship.school || '-' %></p>
        <p><strong>Diploma:</strong><br><%= internship.diploma || '-' %></p>
        <p><strong>Category:</strong><br><%= internship.category || '-' %></p>
        <p><strong>Location:</strong><br><%= internship.location %></p>
        <p><strong>Monthly Allowance:</strong><br>$<%= Number(internship.allowance).toFixed(2) %></p>
        <p><strong>Description:</strong><br><%= internship.description %></p>
        <p><strong>Requirements:</strong><br><%= internship.requirements %></p>
        <p><strong>Closing Date:</strong><br><%= internship.closingDate %></p>
        <!-- Done by: YAP CHIEN TING QUINA (25041331) - Closing Soon display -->
        <% if (internship.closingSoon) { %><p><strong>Closing Soon</strong></p><% } %>

        <!-- ==========================================
        Shared contribution:
        Done by: ZIN WITYEE AUNG (25040225) - student role visibility
        Done by: SHAWN TAY YAO TING (25044598) - application entry point and closing checks
        ========================================== -->
        <% if (user.role === 'student') { %>
            <% if (hasApplied) { %>
                <p>You have already applied for this internship.</p>
            <% } else if (!internship.isOpen) { %>
                <p><strong>Applications Closed</strong></p>
            <% } else { %>
                <a href="/apply/<%= internship.internshipId %>" class="btn btn-primary">Apply</a>
            <% } %>

            <!-- ==========================================
            Done by: YAP CHIEN TING QUINA (25041331)
            Feature: Save and Unsave Internship Controls
            ========================================== -->
            <% if (internship.isSaved) { %>
                <form action="/unsaveInternship/<%= internship.internshipId %>" method="POST" class="d-inline">
                    <button type="submit" class="btn btn-secondary">Unsave</button>
                </form>
            <% } else { %>
                <form action="/saveInternship/<%= internship.internshipId %>" method="POST" class="d-inline">
                    <button type="submit" class="btn btn-secondary">Save</button>
                </form>
            <% } %>
        <% } %>

        <!-- ==========================================
        Shared contribution:
        Done by: ZIN WITYEE AUNG (25040225) - admin role visibility
        Done by: ZELIA TAN LING RUI (25046792) - edit internship entry point
        ========================================== -->
        <% if (user.role === 'admin') { %>
            <a href="/editInternship/<%= internship.internshipId %>" class="btn btn-primary">Edit</a>
        <% } %>

        <a href="/internships" class="btn btn-secondary">Back</a>
    </div>
</body>
</html>
