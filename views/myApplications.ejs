<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Applications - Internship Portal</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</head>
<body>
    <%- include('partials/navbar') %>

    <div class="container mt-4">
        <h2>My Applications</h2>
        <p>Applications submitted by <%= user.username %>.</p>

        <% if (message) { %>
            <div class="alert alert-success"><%= message %></div>
        <% } %>

        <% if (error) { %>
            <div class="alert alert-danger"><%= error %></div>
        <% } %>

        <div class="table-responsive">
            <table class="table table-hover">
                <thead>
                    <tr>
                        <th>Company</th>
                        <th>Job Title</th>
                        <th>Location</th>
                        <th>Applied Date</th>
                        <th>Status</th>
                        <th>Interview Details</th>
                        <th>Offer</th>
                        <th>Withdraw</th>
                    </tr>
                </thead>
                <tbody>
                    <% for (let i = 0; i < applications.length; i++) { %>
                        <tr>
                            <td><%= applications[i].companyName %></td>
                            <td><%= applications[i].jobTitle %></td>
                            <td><%= applications[i].location %></td>
                            <td><%= applications[i].appliedDate %></td>
                            <td>
                                <%= applications[i].status %><br>
                                <a href="/application/<%= applications[i].applicationId %>/history">View History</a>
                            </td>
                            <td>
                                <% if (applications[i].interviewDate) { %>
                                    <strong>Date:</strong> <%= applications[i].interviewDate %><br>
                                    <strong>Time:</strong> <%= applications[i].interviewTime %><br>
                                    <strong>Location:</strong> <%= applications[i].interviewLocation || '-' %><br>
                                    <% if (applications[i].meetingLink) { %>
                                        <strong>Meeting:</strong>
                                        <a href="<%= applications[i].meetingLink %>" target="_blank">Open Link</a><br>
                                    <% } %>
                                    <strong>Notes:</strong> <%= applications[i].interviewNotes || 'None' %>
                                <% } else { %>
                                    -
                                <% } %>
                            </td>
                            <td>
                                <% if (applications[i].status === 'Offered') { %>
                                    <form action="/application/<%= applications[i].applicationId %>/acceptOffer" method="POST" class="mb-1">
                                        <button type="submit" class="btn btn-success btn-sm">Accept Offer</button>
                                    </form>
                                    <form action="/application/<%= applications[i].applicationId %>/declineOffer" method="POST">
                                        <button type="submit" class="btn btn-danger btn-sm">Decline Offer</button>
                                    </form>
                                <% } else { %>
                                    -
                                <% } %>
                            </td>
                            <td>
                                <form action="/withdrawApplication/<%= applications[i].applicationId %>" method="POST">
                                    <button type="submit" class="btn btn-link p-0"
                                        onclick="return confirm('Are you sure you want to withdraw this application?')">
                                        Withdraw
                                    </button>
                                </form>
                            </td>
                        </tr>
                    <% } %>

                    <% if (applications.length === 0) { %>
                        <tr>
                            <td colspan="8">You have not applied for any internships.</td>
                        </tr>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>
</body>
</html>
