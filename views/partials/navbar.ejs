<!-- =====================================================
Done By: ZIN WITYEE AUNG 25040225
Feature: Role-Based Navbar Visibility and Authentication Links
===================================================== -->
<nav class="navbar navbar-expand-sm bg-dark navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="/">RP Internship Portal</a>

        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#collapsibleNavbar">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="collapsibleNavbar">
            <ul class="navbar-nav me-auto">
                <li class="nav-item">
                    <a class="nav-link" href="/">Home</a>
                </li>

                <% if (user) { %>
                    <li class="nav-item">
                        <a class="nav-link" href="/internships">Internship Opportunities</a>
                    </li>

                    <% if (user.role === 'student') { %>
                        <!-- Done By: SHAWN TAY YAO TING 25044598 - Student profile link -->
                        <li class="nav-item">
                            <a class="nav-link" href="/profile">RP Profile</a>
                        </li>
                        <!-- Done By: WONG ZHI LI 25033271 - Application tracking links -->
                        <li class="nav-item">
                            <a class="nav-link" href="/myApplications">My Applications</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/tracker">Tracker</a>
                        </li>
                        <!-- Done By: YAP CHIEN TING QUINA 25041331 - Saved internships link -->
                        <li class="nav-item">
                            <a class="nav-link" href="/savedInternships">Saved Internships</a>
                        </li>
                    <% } %>

                    <% if (user.role === 'admin') { %>
                        <!-- Done By: ZELIA TAN LING RUI 25046792 - Internship CRUD link -->
                        <li class="nav-item">
                            <a class="nav-link" href="/addInternship">Add Internship</a>
                        </li>
                        <!-- Done By: WONG ZHI LI 25033271 - Admin application management link -->
                        <li class="nav-item">
                            <a class="nav-link" href="/applications">Applications</a>
                        </li>
                    <% } %>
                <% } %>
            </ul>

            <ul class="navbar-nav">
                <% if (user) { %>
                    <li class="nav-item">
                        <span class="navbar-text me-3"><%= user.username %> (<%= user.role %>)</span>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/logout">Logout</a>
                    </li>
                <% } else { %>
                    <li class="nav-item">
                        <a class="nav-link" href="/login">Login</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/register">Register</a>
                    </li>
                <% } %>
            </ul>
        </div>
    </div>
</nav>
