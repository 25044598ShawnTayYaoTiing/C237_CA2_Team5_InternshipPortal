<!-- ==========================================
Done by: ZIN WITYEE AUNG (25040225)
Feature: Role-Based Navbar Visibility and Authentication Links
This navbar is shared with the feature owners identified below.
========================================== -->
<nav class="navbar navbar-expand-sm bg-dark navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="/">Internship Portal</a>

        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#collapsibleNavbar">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="collapsibleNavbar">
            <ul class="navbar-nav me-auto">
                <li class="nav-item">
                    <a class="nav-link" href="/">Home</a>
                </li>

                <% if (user) { %>
                    <!-- Shared: ZELIA TAN LING RUI (25046792) - internship viewing;
                    YAP CHIEN TING QUINA (25041331) - internship searching/filtering -->
                    <li class="nav-item">
                        <a class="nav-link" href="/internships">Internships</a>
                    </li>

                    <% if (user.role === 'student') { %>
                        <!-- Done by: SHAWN TAY YAO TING (25044598) - student profile -->
                        <li class="nav-item">
                            <a class="nav-link" href="/profile">Profile</a>
                        </li>
                        <!-- Done by: WONG ZHI LI (25033271) - application tracking links -->
                        <li class="nav-item">
                            <a class="nav-link" href="/myApplications">My Applications</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/tracker">Tracker</a>
                        </li>
                        <!-- Done by: YAP CHIEN TING QUINA (25041331) - saved internships -->
                        <li class="nav-item">
                            <a class="nav-link" href="/savedInternships">Saved Internships</a>
                        </li>
                    <% } %>

                    <% if (user.role === 'admin') { %>
                        <!-- Done by: ZELIA TAN LING RUI (25046792) - internship CRUD -->
                        <li class="nav-item">
                            <a class="nav-link" href="/addInternship">Add Internship</a>
                        </li>
                        <!-- Done by: WONG ZHI LI (25033271) - admin application management -->
                        <li class="nav-item">
                            <a class="nav-link" href="/applications">Applications</a>
                        </li>
                    <% } %>
                <% } %>
            </ul>

            <ul class="navbar-nav">
                <% if (user) { %>
                    <li class="nav-item">
                        <span class="navbar-text me-3">Welcome, <%= user.username %> (<%= user.role %>)</span>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/logout">Logout</a>
                    </li>
                <% } else { %>
                    <li class="nav-item">
                        <a class="nav-link" href="/login">Login</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/register">Register</a>
                    </li>
                <% } %>
            </ul>
        </div>
    </div>
</nav>
