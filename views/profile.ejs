<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>RP Student Profile - RP Internship Portal</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</head>
<body>
    <%- include('partials/navbar') %>

    <div class="container mt-5">
        <h1>RP Student Profile</h1>
        <p>View your RP student details and manage your resume documents.</p>

        <% if (message) { %>
            <div class="alert alert-success"><%= message %></div>
        <% } %>

        <% if (error) { %>
            <div class="alert alert-danger"><%= error %></div>
        <% } %>

        <h3>RP Student Information</h3>
        <div class="card p-3 mb-4">
            <table class="table table-bordered mb-0">
                <tbody>
                    <tr>
                        <th>Name</th>
                        <td><%= profile.username %></td>
                    </tr>
                    <tr>
                        <th>Email</th>
                        <td><%= profile.email %></td>
                    </tr>
                    <tr>
                        <th>School</th>
                        <td><%= profile.school || 'Not set' %></td>
                    </tr>
                    <tr>
                        <th>Diploma</th>
                        <td><%= profile.diploma || 'Not set' %></td>
                    </tr>
                </tbody>
            </table>
        </div>

        <h3>Resume Management</h3>
        <div class="card p-3">
            <div class="table-responsive">
                <table class="table table-striped table-bordered align-middle">
                    <thead>
                        <tr>
                            <th>Resume Name</th>
                            <th>Uploaded File</th>
                            <th>Upload Date</th>
                            <th>View</th>
                            <th>Delete</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% for (let i = 0; i < documents.length; i++) { %>
                            <tr>
                                <td><%= documents[i].resumeName || documents[i].fileName %></td>
                                <td><%= documents[i].fileName %></td>
                                <td><%= documents[i].uploadedAt %></td>
                                <td><a href="/document/<%= documents[i].documentId %>" target="_blank" class="btn btn-dark btn-sm">View</a></td>
                                <td>
                                    <form action="/deleteDocument/<%= documents[i].documentId %>" method="POST">
                                        <button type="submit" class="btn btn-danger btn-sm"
                                            onclick="return confirm('Delete this document?')">Delete</button>
                                    </form>
                                </td>
                            </tr>
                        <% } %>

                        <% if (documents.length === 0) { %>
                            <tr><td colspan="5" class="text-center">No resume documents uploaded.</td></tr>
                        <% } %>
                    </tbody>
                </table>
            </div>

            <form action="/uploadResume" method="POST" enctype="multipart/form-data" class="mt-3">
                <div class="mb-3">
                    <label for="resumeName" class="form-label">Resume Name (Optional):</label>
                    <input type="text" id="resumeName" name="resumeName" class="form-control"
                        maxlength="100" placeholder="For example: Software Developer Resume">
                </div>
                <div class="mb-3">
                    <label for="resume" class="form-label">Upload New Resume (PDF only):</label>
                    <input type="file" id="resume" name="resume" class="form-control" accept="application/pdf,.pdf" required>
                </div>
                <button type="submit" class="btn btn-primary">Upload Resume</button>
            </form>
        </div>
    </div>
</body>
</html>
