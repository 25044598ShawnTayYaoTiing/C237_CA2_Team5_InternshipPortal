<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Student Profile - Internship Portal</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</head>
<body>
    <%- include('partials/navbar') %>

    <div class="container mt-4">
        <h2>Student Profile</h2>

        <% if (message) { %>
            <div class="alert alert-success"><%= message %></div>
        <% } %>

        <% if (error) { %>
            <div class="alert alert-danger"><%= error %></div>
        <% } %>

        <p><strong>Username:</strong> <%= profile.username %></p>
        <p><strong>Email:</strong> <%= profile.email %></p>
        <p><strong>School:</strong> <%= profile.school || 'Not set' %></p>
        <p><strong>Diploma:</strong> <%= profile.diploma || 'Not set' %></p>
        <h3>My Documents</h3>
        <div class="table-responsive">
            <table class="table table-hover">
                <thead>
                    <tr>
                        <th>Resume Name</th>
                        <th>File Name</th>
                        <th>Type</th>
                        <th>Uploaded</th>
                        <th>View</th>
                        <th>Delete</th>
                    </tr>
                </thead>
                <tbody>
                    <% for (let i = 0; i < documents.length; i++) { %>
                        <tr>
                            <td><%= documents[i].resumeName || documents[i].fileName %></td>
                            <td><%= documents[i].fileName %></td>
                            <td><%= documents[i].documentType %></td>
                            <td><%= documents[i].uploadedAt %></td>
                            <td><a href="/document/<%= documents[i].documentId %>" target="_blank">View</a></td>
                            <td>
                                <form action="/deleteDocument/<%= documents[i].documentId %>" method="POST">
                                    <button type="submit" class="btn btn-link p-0"
                                        onclick="return confirm('Delete this document?')">Delete</button>
                                </form>
                            </td>
                        </tr>
                    <% } %>

                    <% if (documents.length === 0) { %>
                        <tr><td colspan="6">No resume documents uploaded.</td></tr>
                    <% } %>
                </tbody>
            </table>
        </div>

        <form action="/uploadResume" method="POST" enctype="multipart/form-data" class="mt-4">
            <div class="mb-3">
                <label for="resumeName" class="form-label">Resume Name (Optional):</label>
                <input type="text" id="resumeName" name="resumeName" class="form-control"
                    maxlength="100" placeholder="For example: Software Developer Resume">
            </div>
            <div class="mb-3">
                <label for="resume" class="form-label">Upload New Resume (PDF only):</label>
                <input type="file" id="resume" name="resume" class="form-control" accept="application/pdf,.pdf" required>
            </div>
            <button type="submit" class="btn btn-primary">Upload Resume</button>
        </form>
    </div>
</body>
</html>
