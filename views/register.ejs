<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Register - Internship Portal</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</head>
<body style="background-color: #FFF8E7;">
    <%- include('partials/navbar') %>

    <div class="container mt-5">
        <h1>Student Registration</h1>
        <p>Create an RP student account for internship applications.</p>

        <% if (error) { %>
            <div class="alert alert-danger"><%= error %></div>
        <% } %>

        <div class="row">
            <div class="col-md-8">
                <div class="card p-3">
                    <form action="/register" method="POST">
                        <div class="mb-3">
                            <label for="username" class="form-label">Name:</label>
                            <input type="text" id="username" name="username" class="form-control"
                                value="<%= formData.username || '' %>" required>
                        </div>

                        <div class="mb-3">
                            <label for="email" class="form-label">Email:</label>
                            <input type="email" id="email" name="email" class="form-control"
                                value="<%= formData.email || '' %>" required>
                        </div>

                        <div class="mb-3">
                            <label for="school" class="form-label">School:</label>
                            <select id="school" name="school" class="form-select" required>
                                <option value="">Select School</option>
                                <% for (const schoolName in schoolDiplomas) { %>
                                    <option value="<%= schoolName %>"
                                        <%= formData.school === schoolName ? 'selected' : '' %>>
                                        <%= schoolName %> - <%= schoolNames[schoolName] %>
                                    </option>
                                <% } %>
                            </select>
                        </div>

                        <div class="mb-3">
                            <label for="diploma" class="form-label">Diploma:</label>
                            <select id="diploma" name="diploma" class="form-select" required>
                                <option value="">Select Diploma</option>
                                <% for (const schoolName in schoolDiplomas) { %>
                                    <% for (let i = 0; i < schoolDiplomas[schoolName].length; i++) { %>
                                        <option value="<%= schoolDiplomas[schoolName][i] %>" data-school="<%= schoolName %>"
                                            <%= formData.diploma === schoolDiplomas[schoolName][i] ? 'selected' : '' %>>
                                            <%= schoolDiplomas[schoolName][i] %>
                                        </option>
                                    <% } %>
                                <% } %>
                            </select>
                        </div>

                        <div class="mb-3">
                            <label for="password" class="form-label">Password:</label>
                            <input type="password" id="password" name="password" class="form-control" minlength="6" required>
                            <small class="form-text text-muted">Password must have at least 6 characters.</small>
                        </div>

                        <div class="mb-3">
                            <label for="confirmPassword" class="form-label">Confirm Password:</label>
                            <input type="password" id="confirmPassword" name="confirmPassword" class="form-control" required>
                        </div>

                        <button type="submit" class="btn btn-primary">Register</button>
                        <a href="/login" class="btn btn-secondary">Back to Login</a>
                    </form>
                </div>
            </div>
        </div>
    </div>
    <script>
        const schoolSelect = document.getElementById('school');
        const diplomaSelect = document.getElementById('diploma');

        function updateDiplomas() {
            for (let i = 1; i < diplomaSelect.options.length; i++) {
                const option = diplomaSelect.options[i];
                const matches = option.dataset.school === schoolSelect.value;
                option.hidden = !matches;
                option.disabled = !matches;
            }
            if (diplomaSelect.selectedOptions[0] && diplomaSelect.selectedOptions[0].disabled) {
                diplomaSelect.value = '';
            }
        }

        schoolSelect.addEventListener('change', updateDiplomas);
        updateDiplomas();
    </script>
</body>
</html>
