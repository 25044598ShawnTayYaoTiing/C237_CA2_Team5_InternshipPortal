<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Saved Internships - Internship Portal</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</head>
<body>
    <%- include('partials/navbar') %>

    <div class="container mt-4">
        <h2>Saved Internships</h2>
        <div class="table-responsive">
            <table class="table table-hover">
                <thead>
                    <tr>
                        <th>Company</th>
                        <th>Job Title</th>
                        <th>Location</th>
                        <th>Allowance</th>
                        <th>Closing Date</th>
                        <th>View</th>
                        <th>Unsave</th>
                    </tr>
                </thead>
                <tbody>
                    <% for (let i = 0; i < internships.length; i++) { %>
                        <tr>
                            <td><%= internships[i].companyName %></td>
                            <td><%= internships[i].jobTitle %></td>
                            <td><%= internships[i].location %></td>
                            <td>$<%= Number(internships[i].allowance).toFixed(2) %></td>
                            <td>
                                <%= internships[i].closingDate %>
                                <% if (internships[i].closingSoon) { %><br>Closing Soon<% } %>
                            </td>
                            <td><a href="/internship/<%= internships[i].internshipId %>">View</a></td>
                            <td>
                                <form action="/unsaveInternship/<%= internships[i].internshipId %>" method="POST">
                                    <input type="hidden" name="from" value="saved">
                                    <button type="submit" class="btn btn-link p-0">Unsave</button>
                                </form>
                            </td>
                        </tr>
                    <% } %>

                    <% if (internships.length === 0) { %>
                        <tr><td colspan="7">No saved internships.</td></tr>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>
</body>
</html>
