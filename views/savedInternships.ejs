<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Saved Internships - RP Internship Portal</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</head>
<body style="background-color: #FFF8E7;">
    <%- include('partials/navbar') %>

    <div class="container mt-5">
        <h1>Saved Internships</h1>
        <p>Internship opportunities you saved for later.</p>
        <div class="table-responsive">
            <table class="table table-striped table-bordered align-middle">
                <thead>
                    <tr>
                        <th>Company</th>
                        <th>Job Title</th>
                        <th>Location</th>
                        <th>Allowance</th>
                        <th>Closing Date</th>
                        <th>View</th>
                        <th>Unsave</th>
                    </tr>
                </thead>
                <tbody>
                    <% for (let i = 0; i < internships.length; i++) { %>
                        <tr>
                            <td><%= internships[i].companyName %></td>
                            <td><strong><%= internships[i].jobTitle %></strong></td>
                            <td><%= internships[i].location %></td>
                            <td>$<%= Number(internships[i].allowance).toFixed(2) %></td>
                            <td>
                                <%= internships[i].closingDate %>
                                <% if (internships[i].closingSoon) { %><br><span class="badge bg-warning text-dark">Closing Soon</span><% } %>
                            </td>
                            <td><a href="/internship/<%= internships[i].internshipId %>" class="btn btn-dark btn-sm">View</a></td>
                            <td>
                                <form action="/unsaveInternship/<%= internships[i].internshipId %>" method="POST">
                                    <input type="hidden" name="from" value="saved">
                                    <button type="submit" class="btn btn-secondary btn-sm">Unsave</button>
                                </form>
                            </td>
                        </tr>
                    <% } %>

                    <% if (internships.length === 0) { %>
                        <tr><td colspan="7" class="text-center">No saved internships.</td></tr>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>
</body>
</html>
