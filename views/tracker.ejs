<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Application Tracker - Internship Portal</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</head>
<body>
    <%- include('partials/navbar') %>

    <div class="container mt-4">
        <h2>Application Tracker</h2>

        <div class="table-responsive mb-4">
            <table class="table table-bordered text-center">
                <thead>
                    <tr>
                        <th>Total Applications</th>
                        <th>Pending</th>
                        <th>Shortlisted</th>
                        <th>Interview</th>
                        <th>Offered</th>
                        <th>Accepted</th>
                        <th>Rejected</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td><%= stats.total %></td>
                        <td><%= stats.Pending %></td>
                        <td><%= stats.Shortlisted %></td>
                        <td><%= stats.Interview %></td>
                        <td><%= stats.Offered %></td>
                        <td><%= stats.Accepted %></td>
                        <td><%= stats.Rejected %></td>
                    </tr>
                </tbody>
            </table>
        </div>

        <h3>My Applications</h3>
        <div class="table-responsive">
            <table class="table table-hover">
                <thead>
                    <tr>
                        <th>Company</th>
                        <th>Job Title</th>
                        <th>Status</th>
                        <th>Applied Date</th>
                    </tr>
                </thead>
                <tbody>
                    <% for (let i = 0; i < applications.length; i++) { %>
                        <tr>
                            <td><%= applications[i].companyName %></td>
                            <td><%= applications[i].jobTitle %></td>
                            <td><%= applications[i].status %></td>
                            <td><%= applications[i].appliedDate %></td>
                        </tr>
                    <% } %>

                    <% if (applications.length === 0) { %>
                        <tr>
                            <td colspan="4">You have not applied for any internships.</td>
                        </tr>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>
</body>
</html>
