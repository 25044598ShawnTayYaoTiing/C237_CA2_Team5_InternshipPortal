<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Application Tracker - RP Internship Portal</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</head>
<body style="background-color: #FFF8E7;">
    <%- include('partials/navbar') %>

    <div class="container mt-5">
        <h1>Application Tracker</h1>
        <p>A simple summary of your internship application statuses.</p>

        <div class="row mt-4">
            <div class="col-md-3 mb-3">
                <div class="card p-3 text-center">
                    <h2><%= stats.total %></h2>
                    <p>Total Applications</p>
                </div>
            </div>
            <div class="col-md-3 mb-3">
                <div class="card p-3 text-center border-warning">
                    <h2><%= stats.Pending %></h2>
                    <p>Pending</p>
                </div>
            </div>
            <div class="col-md-3 mb-3">
                <div class="card p-3 text-center border-info">
                    <h2><%= stats.Shortlisted %></h2>
                    <p>Shortlisted</p>
                </div>
            </div>
            <div class="col-md-3 mb-3">
                <div class="card p-3 text-center border-primary">
                    <h2><%= stats.Interview %></h2>
                    <p>Interview</p>
                </div>
            </div>
            <div class="col-md-3 mb-3">
                <div class="card p-3 text-center border-primary">
                    <h2><%= stats.Offered %></h2>
                    <p>Offered</p>
                </div>
            </div>
            <div class="col-md-3 mb-3">
                <div class="card p-3 text-center border-success">
                    <h2><%= stats.Accepted %></h2>
                    <p>Accepted</p>
                </div>
            </div>
            <div class="col-md-3 mb-3">
                <div class="card p-3 text-center border-danger">
                    <h2><%= stats.Rejected %></h2>
                    <p>Rejected</p>
                </div>
            </div>
        </div>

        <h3>My Applications</h3>
        <div class="table-responsive">
            <table class="table table-striped table-bordered align-middle">
                <thead>
                    <tr>
                        <th>Company</th>
                        <th>Job Title</th>
                        <th>Status</th>
                        <th>Applied Date</th>
                    </tr>
                </thead>
                <tbody>
                    <% for (let i = 0; i < applications.length; i++) { %>
                        <tr>
                            <td><%= applications[i].companyName %></td>
                            <td><strong><%= applications[i].jobTitle %></strong></td>
                            <td>
                                <% let statusClass = 'bg-secondary'; %>
                                <% if (applications[i].status === 'Pending') { statusClass = 'bg-warning text-dark'; } %>
                                <% if (applications[i].status === 'Shortlisted') { statusClass = 'bg-info text-dark'; } %>
                                <% if (applications[i].status === 'Interview') { statusClass = 'bg-primary'; } %>
                                <% if (applications[i].status === 'Offered') { statusClass = 'bg-primary'; } %>
                                <% if (applications[i].status === 'Accepted') { statusClass = 'bg-success'; } %>
                                <% if (applications[i].status === 'Rejected') { statusClass = 'bg-danger'; } %>
                                <span class="badge <%= statusClass %>"><%= applications[i].status %></span>
                            </td>
                            <td><%= applications[i].appliedDate %></td>
                        </tr>
                    <% } %>

                    <% if (applications.length === 0) { %>
                        <tr>
                            <td colspan="4" class="text-center">You have not applied for any internships.</td>
                        </tr>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>
</body>
</html>
